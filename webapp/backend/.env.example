# Backend Environment Variables
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
DOWNLOAD_DIR=downloads
MAX_DOWNLOAD_SIZE=500          # MB per file
MAX_DURATION_SECONDS=3600
FILE_TTL_SECONDS=900           # downloaded files are deleted after this
RATE_LIMIT_PER_MINUTE=5        # per client IP
MAX_CONCURRENT_DOWNLOADS=2
ALLOW_ANY_URL=false            # true = let yt-dlp try sites outside the supported list
TRUST_PROXY=true               # read X-Forwarded-For (needed behind Railway/Render/Cloud Run)
TRUST_PROXY_HOPS=1             # number of trusted proxies in front of the app
# Facebook/Instagram need login cookies (Netscape cookies.txt). Use one of:
# COOKIES_FILE=/etc/secrets/cookies.txt
# COOKIES_CONTENT=<paste file contents as a secret>
